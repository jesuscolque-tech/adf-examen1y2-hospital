{
	"name": "DF_Silver_Admissions",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Admissions",
						"type": "DatasetReference"
					},
					"name": "source1"
				},
				{
					"dataset": {
						"referenceName": "DS_Bronze_Patients",
						"type": "DatasetReference"
					},
					"name": "source2"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Admissions",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "filter1"
				},
				{
					"name": "exists1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          admission_id as string,",
				"          patient_id as string,",
				"          admission_date as string,",
				"          discharge_date as string,",
				"          department as string,",
				"          attending_doctor_id as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source2",
				"source1 derive(admission_id = iif(     isNull(admission_id) || trim(admission_id) == '',     toInteger(null()),     toInteger(trim(admission_id)) ),",
				"          patient_id = iif(     isNull(patient_id) || trim(patient_id) == '',     toInteger(null()),     toInteger(trim(patient_id)) ),",
				"          admission_date = iif(\r",
				"    isNull(admission_date) || trim(admission_date) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(trim(admission_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"        toDate(\r",
				"            concat(\r",
				"                substring(trim(admission_date), 1, 6),\r",
				"                '20',\r",
				"                substring(trim(admission_date), 7, 2)\r",
				"            ),\r",
				"            'MM-dd-yyyy'\r",
				"        ),\r",
				"        iif(\r",
				"            regexMatch(trim(admission_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"            toDate(trim(admission_date), 'yyyy-MM-dd'),\r",
				"            iif(\r",
				"                isDate(trim(admission_date), 'MM/dd/yyyy'),\r",
				"                toDate(trim(admission_date), 'MM/dd/yyyy'),\r",
				"                iif(\r",
				"                    isDate(trim(admission_date), 'dd/MM/yyyy'),\r",
				"                    toDate(trim(admission_date), 'dd/MM/yyyy'),\r",
				"                    iif(\r",
				"                        isDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
				"                        toDate(trim(admission_date), 'dd-MMM-yyyy'),\r",
				"                        iif(\r",
				"                            isDate(trim(admission_date), 'dd-MMM-yy'),\r",
				"                            toDate(\r",
				"                                concat(\r",
				"                                    substring(trim(admission_date), 1, 7),\r",
				"                                    '20',\r",
				"                                    substring(trim(admission_date), 8, 2)\r",
				"                                ),\r",
				"                                'dd-MMM-yyyy'\r",
				"                            ),\r",
				"                            iif(\r",
				"                                isDate(trim(admission_date), 'MMMM dd, yyyy'),\r",
				"                                toDate(trim(admission_date), 'MMMM dd, yyyy'),\r",
				"                                toDate(null())\r",
				"                            )\r",
				"                        )\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          discharge_date = iif(\r",
				"    isNull(discharge_date) || trim(discharge_date) == '',\r",
				"    toDate(null()),\r",
				"    iif(\r",
				"        regexMatch(trim(discharge_date), '^[0-9]{2}-[0-9]{2}-[0-9]{2}$'),\r",
				"        toDate(\r",
				"            concat(\r",
				"                substring(trim(discharge_date), 1, 6),\r",
				"                '20',\r",
				"                substring(trim(discharge_date), 7, 2)\r",
				"            ),\r",
				"            'MM-dd-yyyy'\r",
				"        ),\r",
				"        iif(\r",
				"            regexMatch(trim(discharge_date), '^[0-9]{4}-[0-9]{2}-[0-9]{2}$'),\r",
				"            toDate(trim(discharge_date), 'yyyy-MM-dd'),\r",
				"            iif(\r",
				"                isDate(trim(discharge_date), 'MM/dd/yyyy'),\r",
				"                toDate(trim(discharge_date), 'MM/dd/yyyy'),\r",
				"                iif(\r",
				"                    isDate(trim(discharge_date), 'dd/MM/yyyy'),\r",
				"                    toDate(trim(discharge_date), 'dd/MM/yyyy'),\r",
				"                    iif(\r",
				"                        isDate(trim(discharge_date), 'dd-MMM-yyyy'),\r",
				"                        toDate(trim(discharge_date), 'dd-MMM-yyyy'),\r",
				"                        iif(\r",
				"                            isDate(trim(discharge_date), 'dd-MMM-yy'),\r",
				"                            toDate(\r",
				"                                concat(\r",
				"                                    substring(trim(discharge_date), 1, 7),\r",
				"                                    '20',\r",
				"                                    substring(trim(discharge_date), 8, 2)\r",
				"                                ),\r",
				"                                'dd-MMM-yyyy'\r",
				"                            ),\r",
				"                            iif(\r",
				"                                isDate(trim(discharge_date), 'MMMM dd, yyyy'),\r",
				"                                toDate(trim(discharge_date), 'MMMM dd, yyyy'),\r",
				"                                toDate(null())\r",
				"                            )\r",
				"                        )\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          department = iif(\r",
				"    isNull(department) || trim(department) == '',\r",
				"    toString(null()),\r",
				"    iif(\r",
				"        lower(trim(department)) == 'onco' ||\r",
				"        lower(trim(department)) == 'oncology',\r",
				"        'Oncology',\r",
				"        iif(\r",
				"            lower(trim(department)) == 'cardio' ||\r",
				"            lower(trim(department)) == 'cardiolgy' ||\r",
				"            lower(trim(department)) == 'cardiology',\r",
				"            'Cardiology',\r",
				"            iif(\r",
				"                lower(trim(department)) == 'gen surg' ||\r",
				"                lower(trim(department)) == 'generalsurgery' ||\r",
				"                lower(trim(department)) == 'general surgery',\r",
				"                'General Surgery',\r",
				"                iif(\r",
				"                    lower(trim(department)) == 'neuro' ||\r",
				"                    lower(trim(department)) == 'neurolgy' ||\r",
				"                    lower(trim(department)) == 'neurology',\r",
				"                    'Neurology',\r",
				"                    iif(\r",
				"                        lower(trim(department)) == 'peds' ||\r",
				"                        lower(trim(department)) == 'pediatrics' ||\r",
				"                        lower(trim(department)) == 'paediatrics',\r",
				"                        'Pediatrics',\r",
				"                        iif(\r",
				"                            lower(trim(department)) == 'er' ||\r",
				"                            lower(trim(department)) == 'emergency' ||\r",
				"                            lower(trim(department)) == 'emergency department',\r",
				"                            'Emergency',\r",
				"                            initCap(lower(regexReplace(trim(department), '\\\\s+', ' ')))\r",
				"                        )\r",
				"                    )\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          attending_doctor_id = iif(     isNull(attending_doctor_id) || trim(attending_doctor_id) == '',     toInteger(null()),     toInteger(trim(attending_doctor_id)) )) ~> derivedColumn1",
				"derivedColumn1 filter(!isNull(admission_id) &&",
				"!isNull(patient_id) &&",
				"!isNull(admission_date) &&",
				"!isNull(department) &&",
				"trim(department) != '' &&",
				"!isNull(attending_doctor_id)) ~> filter1",
				"filter1, filter2 exists(derivedColumn1@patient_id == derivedColumn2@patient_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> exists1",
				"source2 derive(patient_id = iif(     isNull(patient_id) || trim(patient_id) == '',     toInteger(null()),     toInteger(trim(patient_id)) )) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(patient_id) &&",
				"!isNull(full_name) &&",
				"trim(full_name) != '') ~> filter2",
				"exists1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          admission_id,",
				"          patient_id,",
				"          admission_date,",
				"          discharge_date,",
				"          department,",
				"          attending_doctor_id",
				"     )) ~> sink1"
			]
		}
	}
}