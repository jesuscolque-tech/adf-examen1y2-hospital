{
	"name": "DF_Gold_DimDiagnostico",
	"properties": {
		"folder": {
			"name": "Gold"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Diagnoses",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "gold_dim_diagnostico",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [],
			"scriptLines": [
				"source(output(",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     query: 'SELECT DISTINCT\\n    TRIM(icd_code) AS codigo_icd,\\n    NULLIF(TRIM(diagnosis_description), \\'\\') AS descripcion_patologia,\\n    COALESCE(\\n        NULLIF(TRIM(severity), \\'\\'),\\n        \\'No especificado\\'\\n    ) AS nivel_severidad\\nFROM silver.diagnoses\\n\\nUNION ALL\\n\\nSELECT\\n    \\'SIN_DIAGNOSTICO\\' AS codigo_icd,\\n    \\'Sin diagnóstico registrado\\' AS descripcion_patologia,\\n    \\'No especificado\\' AS nivel_severidad',",
				"     format: 'query') ~> source1",
				"source1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnostico_key as integer,",
				"          codigo_icd as string,",
				"          descripcion_patologia as string,",
				"          nivel_severidad as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          codigo_icd,",
				"          descripcion_patologia,",
				"          nivel_severidad",
				"     )) ~> sink1"
			]
		}
	}
}