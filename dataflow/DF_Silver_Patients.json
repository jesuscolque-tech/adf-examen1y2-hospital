{
	"name": "DF_Silver_Patients",
	"properties": {
		"folder": {
			"name": "Silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_Bronze_Patients",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DS_Silver_Patients",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "filter1"
				},
				{
					"name": "window1"
				},
				{
					"name": "filter2"
				}
			],
			"scriptLines": [
				"source(output(",
				"          patient_id as string,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as string,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(full_name = trim(full_name),",
				"          gender = iif(\r",
				"    lower(trim(gender)) == 'm' || lower(trim(gender)) == 'male',\r",
				"    'Male',\r",
				"    iif(\r",
				"        lower(trim(gender)) == 'f' || lower(trim(gender)) == 'female',\r",
				"        'Female',\r",
				"        toString(null())\r",
				"    )\r",
				"),",
				"          date_of_birth = iif(\r",
				"    isDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"    toDate(trim(date_of_birth), 'yyyy-MM-dd'),\r",
				"    iif(\r",
				"        isDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"        toDate(trim(date_of_birth), 'MM/dd/yyyy'),\r",
				"        iif(\r",
				"            isDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"            toDate(trim(date_of_birth), 'dd-MMM-yyyy'),\r",
				"            iif(\r",
				"                isDate(trim(date_of_birth), 'MMMM dd, yyyy'),\r",
				"                toDate(trim(date_of_birth), 'MMMM dd, yyyy'),\r",
				"                iif(\r",
				"                    isDate(trim(date_of_birth), 'MM-dd-yy'),\r",
				"                    toDate(\r",
				"                        concat(\r",
				"                            iif(\r",
				"                                toInteger(substring(trim(date_of_birth), 6, 2)) <= 26,\r",
				"                                '20',\r",
				"                                '19'\r",
				"                            ),\r",
				"                            substring(trim(date_of_birth), 6, 2),\r",
				"                            '-',\r",
				"                            substring(trim(date_of_birth), 1, 2),\r",
				"                            '-',\r",
				"                            substring(trim(date_of_birth), 4, 2)\r",
				"                        ),\r",
				"                        'yyyy-MM-dd'\r",
				"                    ),\r",
				"                    toDate(null())\r",
				"                )\r",
				"            )\r",
				"        )\r",
				"    )\r",
				"),",
				"          patient_id = toInteger(trim(patient_id))) ~> derivedColumn1",
				"derivedColumn1 derive(phone = iif(     isNull(phone) || trim(phone) == '' || lower(trim(phone)) == 'unknown',     toString(null()),     regexReplace(trim(phone), '[^0-9]', '') ),",
				"          email = iif(     isNull(email) || trim(email) == '',     toString(null()),     iif(         regexMatch(             lower(trim(email)),             '^[a-z0-9._%+-]+@[a-z0-9.-]+\\\\.[a-z]{2,}$'         ),         lower(trim(email)),         toString(null())     ) ),",
				"          address = iif(     isNull(address) || trim(address) == '',     toString(null()),     regexReplace(trim(address), '\\\\s+', ' ') ),",
				"          insurance_provider = iif(     isNull(insurance_provider) || trim(insurance_provider) == '',     toString(null()),     iif(         lower(trim(insurance_provider)) == 'aetna' ||         lower(trim(insurance_provider)) == 'aetnaa' ||         lower(trim(insurance_provider)) == 'aetna inc.',         'Aetna',         iif(             lower(trim(insurance_provider)) == 'cigna',             'Cigna',             trim(insurance_provider)         )     ) )) ~> derivedColumn2",
				"derivedColumn2 filter(!isNull(patient_id) &&",
				"!isNull(full_name) &&",
				"trim(full_name) != '') ~> filter1",
				"filter1 window(over(patient_id),",
				"     asc(full_name, true),",
				"     NumeroFila = rowNumber()) ~> window1",
				"window1 filter(NumeroFila == 1) ~> filter2",
				"filter2 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          patient_id as integer,",
				"          full_name as string,",
				"          gender as string,",
				"          date_of_birth as date,",
				"          phone as string,",
				"          email as string,",
				"          address as string,",
				"          insurance_provider as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          patient_id,",
				"          full_name,",
				"          gender,",
				"          date_of_birth,",
				"          phone,",
				"          email,",
				"          address,",
				"          insurance_provider",
				"     )) ~> sink1"
			]
		}
	}
}